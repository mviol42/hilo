{
  "name": "@hilo/backend",
  "version": "1.0.0",
  "description": "Backend server for Hi-Lo card game",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.unit.ts",
    "test:watch": "vitest --config vitest.config.unit.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:all": "npm run test && npm run test:integration",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "hilo",
    "card-game",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hilo/shared": "file:../shared",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "redis": "^4.6.5",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.1",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "redis-mock": "^0.56.3",
    "socket.io-client": "^4.6.1",
    "socket.io-mock-ts": "^1.0.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
